# harness-cli local credentials — TEMPLATE (safe to commit and ship).
#
# To use: copy this file to `.env` and fill in your Harness credentials:
#     cp .env.example .env
#     # then edit .env and replace the <...> placeholders with real values
# Then run the CLI with the env file loaded:
#     uv run --env-file .env harness-cli repos get-branch image-build main
#
# `.env` (the real one) is gitignored and excluded from the tarball.
# Never put real keys in this `.env.example` file.

# Required: Harness account ID and API key
POC_HARNESS_ACCOUNT_ID=<your-account-id>
POC_HARNESS_API_KEY=<your-api-key>

# Optional — uncomment to override the defaults shown
# HARNESS_ORG_ID=default
# HARNESS_PROJECT_ID=image_flow
